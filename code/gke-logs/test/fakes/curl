#!/bin/bash
# Stands in for curl in the setup-realtime.sh tests. Answers the
# testIamPermissions calls, granting every requested permission except those
# listed (space separated) in $FAKE_DENIED. A call on the resource named in
# $FAKE_CURL_ERROR (e.g. organizations/123) gets an error, as for a wrong ID.
printf 'curl %s\n' "$*" >> "$FAKE_LOG"

if [ -n "${FAKE_CURL_ERROR-}" ] && [[ "$*" == *"/$FAKE_CURL_ERROR:testIamPermissions"* ]]; then
  echo '{"error": {"code": 403, "message": "The caller does not have permission", "status": "PERMISSION_DENIED"}}'
  exit 0
fi

body=
prev=
for arg in "$@"; do
  [ "$prev" = -d ] && body=$arg
  prev=$arg
done

granted=
for permission in $(printf '%s' "$body" | grep -oE '"[a-z]+(\.[A-Za-z]+)+"' | tr -d '"'); do
  case " ${FAKE_DENIED-} " in *" $permission "*) continue ;; esac
  granted="$granted\"$permission\","
done
printf '{"permissions": [%s]}\n' "${granted%,}"
